# Stage 1: Build application
FROM eclipse-temurin:25-jdk-alpine AS build
WORKDIR /code

# Copy wrapper files and pom.xml first to cache dependencies
COPY .mvn .mvn
COPY mvnw pom.xml ./

# Grant execution permission to wrapper & pre-fetch Maven dependencies
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B

# Copy source code and build production jar
COPY src src
RUN ./mvnw package -DskipTests -Dquarkus.package.type=fast-jar

# Stage 2: Create lightweight non-root runtime image
FROM eclipse-temurin:25-jre-alpine
WORKDIR /deployments

# Create non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy the entire Quarkus deployment directory in one layer
COPY --chown=appuser:appgroup --from=build /code/target/quarkus-app/ /deployments/

USER appuser

EXPOSE 8080

ENV JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /deployments/quarkus-run.jar"]