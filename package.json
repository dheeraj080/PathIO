{
  "name": "pathio-workspace",
  "private": true,
  "description": "Convenience scripts that delegate to the frontend workspace. The backend is a Maven project (see pom.xml).",
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "mock": "npm --prefix frontend run mock",
    "demo": "npm --prefix frontend run demo",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test",
    "test:watch": "npm --prefix frontend run test:watch"
  }
}
