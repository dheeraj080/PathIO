{
  "name": "pathio-workspace",
  "private": true,
  "description": "Convenience scripts that delegate to the web workspace. The backend is a Maven project (see pom.xml).",
  "scripts": {
    "web:install": "npm --prefix web install",
    "dev": "npm --prefix web run dev",
    "mock": "npm --prefix web run mock",
    "demo": "npm --prefix web run demo",
    "build": "npm --prefix web run build",
    "test": "npm --prefix web run test",
    "test:watch": "npm --prefix web run test:watch"
  }
}
