# ==============================================================================
# PathIO Environment Configuration Template
# Copy this file to .env and fill in your local/production credentials
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pathio_db
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Redis Configuration (Caching, Event Buffering & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Configuration
# Must be at least 256-bit (64 characters) HMAC secret key
JWT_SECRET=vS9p8u2M5rX7n4Q1z6W0E3t9Y4A8S5D2F1G7H3J6K9L0P3M1N4B7V2C5X8Z1Q9W0
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=pathio

# URL Shortener Configuration
APP_SHORTENER_DOMAIN=https://path.io/
APP_SHORTENER_SERVICE_HOST=path.io

# CORS Configuration (Comma-separated list of allowed origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# OAuth2 Google Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 GitHub Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Observability & Distributed Tracing
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
