# ==============================================================================
# PathIO Environment Configuration Template
# Copy this file to .env and fill in your local/production credentials
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pathio_db
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Redis Configuration (Caching, Event Buffering & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Configuration
# REQUIRED for non-dev startup. Must be a fresh random secret of at least 64 characters.
# Generate one with:
#   openssl rand -base64 48
#   # or PowerShell:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# The value below is a placeholder that intentionally fails the startup check.
# For local development ONLY you may instead run with SPRING_PROFILES_ACTIVE=dev and
# SECURITY_JWT_DEV_FALLBACK=true (no secret needed; documented dev-only fallback used).
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=pathio

# URL Shortener Configuration
APP_SHORTENER_DOMAIN=https://path.io/
APP_SHORTENER_SERVICE_HOST=path.io

# Administrator Account
# Provisioned on first startup; only this account may use the password login on /login.
# Use the exact lowercase keys below (dotenv injects them verbatim), or set the OS
# environment variables APP_ADMIN_EMAIL / APP_ADMIN_PASSWORD (relaxed-bound).
app.admin.email=admin@pathio.local
app.admin.password=change-me

# CORS Configuration (Comma-separated list of allowed origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# OAuth2 Google Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 GitHub Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Observability & Distributed Tracing
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
